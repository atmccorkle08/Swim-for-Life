# ============================================
# REQUIRED
# ============================================

# Supabase (Database — registrations, donors, campaigns, contact submissions, gallery)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Resend (Transactional Emails — registration confirmations, coach notifications)
RESEND_API_KEY=re_your_api_key_here

# Mailchimp (Newsletter subscriptions)
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_LIST_ID=your_list_id
MAILCHIMP_SERVER_PREFIX=us1

# Site URL
NEXT_PUBLIC_SITE_URL=https://swimsforlife.com

# Admin password for /admin/gallery (server-side only — never prefix with NEXT_PUBLIC_)
ADMIN_PASSWORD=yourpassword

# Ollama (self-hosted AI, reached over Tailscale) — captions/alt text for bulk gallery uploads.
# Only works where the Next.js server is on the tailnet (e.g. `npm run dev` on a Tailscale machine).
# Direct:           OLLAMA_BASE_URL=http://slatestones-mac-mini:11434
# Via Open WebUI:   OLLAMA_BASE_URL=http://slatestones-mac-mini:3000/ollama  (+ OLLAMA_API_KEY)
OLLAMA_BASE_URL=http://slatestones-mac-mini:11434
OLLAMA_MODEL=qwen2.5vl:7b
# OLLAMA_API_KEY=sk-your-open-webui-api-key

# Stripe (Donations) — use sk_test_ keys until you're ready to go live
STRIPE_SECRET_KEY=sk_test_your_test_key_here

# ============================================
# OPTIONAL (Google Sheets sync for coaches)
# ============================================

# Google Sheets API — only needed if syncing registrations to a spreadsheet
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here
